# ==============================================================================
# DailyGurus Price List - Git Ignore
# ==============================================================================

# Database & SQLite Files (Production data must remain private)
database/database.sqlite
database/*.sqlite
database/*.sqlite3
database/*.db
database/*.sql
*.sqlite
*.sqlite3
*.db
*.sql
!supabase/migrations/*.sql
!supabase/seed.sql

# Security, Certificates & Secrets
*.pem
*.key
*.crt
*.pfx
.env
.env.local
.env.production
.env.development
!.env.example
credentials.json
credentials/
secrets/
.cloudflared/

# Logs & Session Files
logs/
*.log
cookies.txt
session_data/
*.tmp
*.temp

# Backups
backup/
backups/
*.bak
*.old
*~

# Temporary scratch files and test profiles
scratch/
scratch*/
scratch_chrome_profile/
scratch_screenshots/
*.js.map
*.css.map

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Runtime / Build artifacts (if any)
node_modules/
vendor/
service/
dist/
build/
