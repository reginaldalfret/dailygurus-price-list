  font-size: 13.5px;
  font-weight: 600;
  color: var(--color-text-main);
}

.form-control {
  width: 100%;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background-color: #FFFFFF;
  color: var(--color-text-main);
  font-size: 14.5px;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.form-control:focus {
  outline: none;
  border-color: var(--color-primary-accent);
  box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.15);
}

textarea.form-control {
  resize: vertical;
  min-height: 120px;
}

.btn-primary-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 28px;
  background-color: var(--color-primary-dark);
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 700;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.btn-primary-submit:hover {
  background-color: var(--color-primary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.alert-success {
  background-color: var(--color-success-bg);
  border: 1px solid #86EFAC;
  color: #166534;
  padding: 14px 18px;
  border-radius: var(--radius-md);
  margin-bottom: 20px;
  font-weight: 600;
}

/* History Archives List */
.history-date-picker-card {
  background-color: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  margin-bottom: 32px;
  box-shadow: var(--shadow-sm);
}

.history-grid-dates {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px;
  margin-top: 18px;
}

.history-date-card {
  background-color: var(--color-bg-surface-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all var(--transition-fast);
  text-decoration: none;
}

.history-date-card:hover, .history-date-card.active {
  background-color: var(--color-primary-subtle);
  border-color: var(--color-primary-border);
  transform: translateY(-2px);
}

.history-date-card.active {
  border-width: 2px;
}

.history-date-card-title {
  font-weight: 700;
  color: var(--color-text-main);
  font-size: 14.5px;
}

.history-date-card-count {
  font-size: 12px;
  color: var(--color-text-muted);
}

/* ==========================================================================
   PRINT STYLES
   ========================================================================== */
@media print {
  .topbar, .site-header, .search-section, .trust-section, .site-footer, .back-to-top, .section-toggle-btn {
    display: none !important;
  }
  body {
    background: #FFFFFF !important;
    color: #000000 !important;
  }
  .accordion-content {
    display: block !important;
  }
  .accordion-chevron {
    display: none !important;
  }
  .accordion-card {
    border: 1px solid #CCC !important;
    break-inside: avoid;
    box-shadow: none !important;
    margin-bottom: 15px;
  }
  .hero-section {
    padding: 10px 0 !important;
    border: none !important;
  }
}
