/**
 * DailyGurus Price List - Comprehensive Design System & Styles
 * Colors: Deep Green (#0D4715, #1B5E20), Fresh Green (#2E7D32, #4CAF50), Orange Accent (#E65100, #FF9800), Light Background (#F8FAFC, #FFFFFF), Charcoal (#161C24)
 */

:root {
  /* Green Palette */
  --color-primary-dark: #0D4715;
  --color-primary: #1B5E20;
  --color-primary-light: #2E7D32;
  --color-primary-accent: #4CAF50;
  --color-primary-subtle: #E8F5E9;
  --color-primary-border: #C8E6C9;
  
  /* Fruits Orange Palette */
  --color-fruit-primary: #E65100;
  --color-fruit-light: #FF9800;
  --color-fruit-subtle: #FFF3E0;
  --color-fruit-border: #FFE0B2;
  
  /* Neutral Palette */
  --color-bg-page: #F8FAFC;
  --color-bg-surface: #FFFFFF;
  --color-bg-surface-alt: #F1F5F9;
  --color-text-main: #0F172A;
  --color-text-body: #334155;
  --color-text-muted: #64748B;
  --color-text-subtle: #94A3B8;
  --color-border: #E2E8F0;
  --color-border-hover: #CBD5E1;
  --color-footer-bg: #161C24;
  --color-footer-subtle: #222B36;
  
  /* Status Colors */
  --color-success: #16A34A;
  --color-success-bg: #DCFCE7;
  --color-warning: #D97706;
  --color-warning-bg: #FEF3C7;
  
  /* Typography */
  --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  
  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
  --shadow-card: 0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
  
  /* Transitions */
  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 250ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-smooth: 350ms cubic-bezier(0.16, 1, 0.3, 1);
  
  /* Layout */
  --max-width: 1200px;
  --header-height: 72px;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-full: 9999px;
}

/* Base & Reset */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font-family);
  background-color: var(--color-bg-page);
  color: var(--color-text-body);
  line-height: 1.55;
  font-size: 15px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

main {
  flex: 1 0 auto;
}

img, svg {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color var(--transition-fast);
}

button, input, select, textarea {
  font: inherit;
}

button {
  cursor: pointer;
  border: none;
  background: none;
}

ul, ol {
  list-style: none;
}

.container {
  width: 100%;
  max-width: var(--max-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: 20px;
  padding-right: 20px;
}

/* ==========================================================================
   TOPBAR
   ========================================================================== */
.topbar {
  background-color: var(--color-primary-dark);
  color: #E2E8F0;
  font-size: 12.5px;
  font-weight: 500;
  padding: 8px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.topbar-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.topbar-badge {
  background: rgba(255, 255, 255, 0.12);
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-weight: 600;
  color: #FFFFFF;
}

.topbar-text {
  color: #CBD5E1;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.topbar-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #E2E8F0;
  transition: color var(--transition-fast);
}

.topbar-link:hover {
  color: #FFFFFF;
}

.topbar-admin-link {
  background: rgba(255, 255, 255, 0.08);
  padding: 2px 10px;
  border-radius: var(--radius-sm);
  color: #86EFAC;
}

.topbar-admin-link:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
}

.topbar-divider {
  color: rgba(255, 255, 255, 0.2);
}

@media (max-width: 768px) {
  .topbar-text {
    display: none;
  }
}

/* ==========================================================================
   HEADER NAVIGATION
   ========================================================================== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--transition-normal);
}

.site-header.is-scrolled {
  box-shadow: var(--shadow-md);
}

.header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--header-height);
  gap: 24px;
}

.header-logo {
  display: flex;
  align-items: center;
}

.header-logo .logo-img {
  height: 44px;
  width: auto;
}

.desktop-nav .nav-menu {
  display: flex;
  align-items: center;
  gap: 8px;
}

.nav-link {
  display: inline-block;
  padding: 8px 16px;
  font-size: 14.5px;
  font-weight: 600;
  color: var(--color-text-body);
  border-radius: var(--radius-full);
  transition: all var(--transition-fast);
}

.nav-link:hover {
  color: var(--color-primary);
  background-color: var(--color-primary-subtle);
}

.nav-link.active {
  color: var(--color-primary-dark);
  background-color: var(--color-primary-subtle);
  font-weight: 700;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-contact-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: var(--color-primary-dark);
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 700;
  padding: 9px 20px;
  border-radius: var(--radius-full);
  box-shadow: 0 2px 4px rgba(13, 71, 21, 0.2);
  transition: all var(--transition-fast);
}

.btn-contact-pill:hover {
  background-color: var(--color-primary);
  transform: translateY(-1px);
  box-shadow: 0 4px 8px rgba(13, 71, 21, 0.25);
  color: #FFFFFF;
}

.btn-contact-pill.active {
  background-color: var(--color-primary);
}

.mobile-menu-btn {
  display: none;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-surface-alt);
  color: var(--color-text-main);
  border: 1px solid var(--color-border);
}

.hamburger-bar {
  width: 20px;
  height: 2px;
  background-color: var(--color-text-main);
  border-radius: 2px;
  transition: all var(--transition-fast);
}

@media (max-width: 900px) {
  .desktop-nav {
    display: none;
  }
  .mobile-menu-btn {
    display: flex;
  }
}

/* Mobile Slide-out Drawer */
.mobile-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(4px);
  z-index: 998;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-normal), visibility var(--transition-normal);
}

.mobile-overlay.is-active {
  opacity: 1;
  visibility: visible;
}

.mobile-nav-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 82%;
  max-width: 320px;
  background-color: #FFFFFF;
  z-index: 999;
  transform: translateX(100%);
  transition: transform var(--transition-smooth);
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-xl);
}

.mobile-nav-drawer.is-open {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  border-bottom: 1px solid var(--color-border);
}

.drawer-close-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  color: var(--color-text-muted);
  background: var(--color-bg-surface-alt);
}

.mobile-nav-menu {
  flex: 1;
  padding: 16px 12px;
  overflow-y: auto;
}

.mobile-nav-menu ul {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mobile-nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text-main);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.mobile-nav-link .nav-icon {
  font-size: 18px;
}

.mobile-nav-link:hover, .mobile-nav-link.active {
  background-color: var(--color-primary-subtle);
  color: var(--color-primary-dark);
}

.drawer-footer {
  padding: 20px;
  border-top: 1px solid var(--color-border);
  background-color: var(--color-bg-page);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.drawer-market-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--color-text-muted);
}

.status-indicator-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-success);
}

.drawer-admin-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-surface);
  border: 1px solid var(--color-border);
  color: var(--color-text-main);
  font-size: 13.5px;
  font-weight: 600;
}

/* ==========================================================================
   HERO SECTION
   ========================================================================== */
.hero-section {
  padding: 32px 0 20px 0;
  background: linear-gradient(180deg, #F0FDF4 0%, #F8FAFC 100%);
  border-bottom: 1px solid var(--color-border);
}

.hero-content {
  text-align: center;
  max-width: 780px;
  margin: 0 auto 20px auto;
}

.hero-main-title {
  font-size: clamp(1.65rem, 4.5vw, 2.75rem);
  font-weight: 800;
  color: var(--color-primary-dark);
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 6px;
  text-transform: capitalize;
}

.hero-subtitle {
  font-size: clamp(0.9rem, 2.2vw, 1.15rem);
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 16px;
}

/* Modern Date Card Component */
.hero-date-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  background: #FFFFFF;
  border: 1px solid #BBF7D0;
  padding: 10px 20px;
  border-radius: var(--radius-lg);
  box-shadow: 0 4px 14px rgba(34, 197, 94, 0.08);
  margin: 0 auto;
}

.date-card-eyebrow {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: var(--color-primary);
  text-transform: uppercase;
}

.date-card-main {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

.date-card-main .cal-icon {
  color: var(--color-primary);
  display: flex;
  align-items: center;
}

.date-card-text {
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--color-primary-dark);
  letter-spacing: -0.01em;
}

.pulse-indicator {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: var(--color-success-bg);
  color: #166534;
  font-size: 11.5px;
  font-weight: 700;
}

.pulse-archive {
  background-color: #FEF3C7;
  color: #92400E;
}

.pulse-dot {
  width: 7px;
  height: 7px;
  background-color: var(--color-success);
  border-radius: 50%;
  position: relative;
}

.pulse-dot::after {
  content: '';
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  border-radius: 50%;
  background-color: var(--color-success);
  animation: pulse-ring 1.8s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
}

@keyframes pulse-ring {
  0% { transform: scale(0.95); opacity: 0.8; }
  50% { transform: scale(1.8); opacity: 0; }
  100% { transform: scale(0.95); opacity: 0; }
}

.hero-banner-card {
  max-width: 1000px;
  margin: 0 auto;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  border: 1px solid rgba(0, 0, 0, 0.06);
  position: relative;
  aspect-ratio: 21 / 9;
  background-color: #E2E8F0;
}

.hero-banner-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 35%;
  transition: transform 0.6s ease;
}

.hero-banner-card:hover img {
  transform: scale(1.02);
}

@media (max-width: 640px) {
  .hero-banner-card {
    aspect-ratio: 16 / 9;
  }
}

/* Historical Notice Banner */
.historical-alert-bar {
  background-color: #FFFBEB;
  border-left: 4px solid #F59E0B;
  padding: 12px 18px;
  border-radius: var(--radius-md);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-shadow: var(--shadow-sm);
}

.historical-alert-text {
  font-size: 13.5px;
  color: #92400E;
  font-weight: 500;
}

.historical-alert-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background-color: #F59E0B;
  color: #FFFFFF;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 12.5px;
  font-weight: 700;
  white-space: nowrap;
}

.historical-alert-btn:hover {
  background-color: #D97706;
}

/* ==========================================================================
   CATEGORY QUICK CARDS (2 EQUAL COLUMNS ON ALL SCREENS)
   ========================================================================== */
.quick-cards-section {
  padding: 20px 0 12px 0;
}

.quick-cards-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.quick-card {
  background-color: var(--color-bg-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 16px 18px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: var(--shadow-card);
  transition: all var(--transition-normal);
  text-decoration: none;
  position: relative;
  overflow: hidden;
}

.quick-card.card-veg {
  border-left: 4px solid var(--color-primary);
}

.quick-card.card-fruit {
  border-left: 4px solid var(--color-fruit-primary);
}

.quick-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-hover);
  border-color: var(--color-primary-accent);
}

.quick-card.card-fruit:hover {
  border-color: var(--color-fruit-primary);
}

.quick-card-img {
  width: 72px;
  height: 72px;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background-color: var(--color-bg-surface-alt);
}

.quick-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-normal);
}

.quick-card:hover .quick-card-img img {
  transform: scale(1.08);
}

.quick-card-body {
  flex: 1;
  min-width: 0;
}

.quick-card-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--color-primary-dark);
  background: var(--color-primary-subtle);
  padding: 2px 6px;
  border-radius: 4px;
  margin-bottom: 4px;
}

.quick-card-badge.badge-fruit-alt {
  color: var(--color-fruit-primary);
  background: var(--color-fruit-subtle);
}

.quick-card-body h3 {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--color-text-main);
  margin-bottom: 2px;
  line-height: 1.25;
}

.quick-card-body p {
  font-size: 12.5px;
  color: var(--color-text-muted);
  margin-bottom: 8px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-card-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--color-primary);
  transition: gap var(--transition-fast);
}

.quick-card.card-fruit .quick-card-btn {
  color: var(--color-fruit-primary);
}

.quick-card:hover .quick-card-btn {
  gap: 8px;
}

/* ==========================================================================
   STICKY MOBILE & DESKTOP CATEGORY JUMP BAR
   ========================================================================== */
.sticky-category-bar {
  position: sticky;
  top: var(--header-height);
  z-index: 85;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-border);
  padding: 8px 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  transition: all var(--transition-fast);
}

.sticky-category-container {
  padding: 0 16px;
}

.category-pills-scroll {
  display: flex;
  align-items: center;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  padding: 2px 0;
}

.category-pills-scroll::-webkit-scrollbar {
  display: none;
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: var(--radius-full);
  background-color: var(--color-bg-surface-alt);
  border: 1px solid var(--color-border);
  color: var(--color-text-main);
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  text-decoration: none;
  transition: all var(--transition-fast);
  min-height: 36px;
  cursor: pointer;
}

.cat-pill:hover, .cat-pill.active {
  background-color: var(--color-primary-dark);
  border-color: var(--color-primary-dark);
  color: #FFFFFF;
  box-shadow: 0 2px 8px rgba(22, 101, 52, 0.25);
  transform: translateY(-1px);
}

.cat-pill-fruit.active {
  background-color: var(--color-fruit-primary);
  border-color: var(--color-fruit-primary);
  color: #FFFFFF;
  box-shadow: 0 2px 8px rgba(234, 88, 12, 0.25);
}

/* ==========================================================================
   SEARCH BAR
   ========================================================================== */
.search-section {
  padding: 14px 0 20px 0;
}

.search-container-box {
  background-color: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 6px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 48px;
  transition: all var(--transition-fast);
}

.search-container-box:focus-within {
  border-color: var(--color-primary-accent);
  box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.15), var(--shadow-md);
}

.search-icon-wrap {
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 14.5px;
  color: var(--color-text-main);
  background: transparent;
  padding: 8px 0;
  min-width: 0;
}

.search-input::placeholder {
  color: var(--color-text-subtle);
}

.search-count-badge {
  display: none;
  font-size: 12px;
  font-weight: 700;
  padding: 3px 10px;
  background-color: var(--color-primary-subtle);
  color: var(--color-primary-dark);
  border-radius: var(--radius-full);
  white-space: nowrap;
}

.search-clear-btn {
  display: none;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background-color: var(--color-bg-surface-alt);
  color: var(--color-text-muted);
  transition: all var(--transition-fast);
}

.search-clear-btn:hover {
  background-color: #E2E8F0;
  color: var(--color-text-main);
}

/* ==========================================================================
   SECTION HEADINGS & TOGGLES
   ========================================================================== */
.section-header-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24px;
  margin-bottom: 16px;
  gap: 16px;
  flex-wrap: wrap;
}

.section-title-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  padding: 8px 18px;
  border-radius: var(--radius-full);
}

.badge-veg {
  background-color: var(--color-primary-subtle);
  color: var(--color-primary-dark);
  border: 1px solid var(--color-primary-border);
}

.badge-fruit {
  background-color: var(--color-fruit-subtle);
  color: var(--color-fruit-primary);
  border: 1px solid var(--color-fruit-border);
}

.section-toggle-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--color-primary);
  background-color: #FFFFFF;
  border: 1px solid var(--color-border);
  padding: 7px 14px;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.section-toggle-btn:hover {
  background-color: var(--color-primary-subtle);
  border-color: var(--color-primary-border);
}

.section-toggle-btn.btn-fruit {
  color: var(--color-fruit-primary);
}

.section-toggle-btn.btn-fruit:hover {
  background-color: var(--color-fruit-subtle);
  border-color: var(--color-fruit-border);
}

/* ==========================================================================
   ACCORDIONS & PRICE TABLES
   ========================================================================== */
.accordions-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 32px;
}

.accordion-card {
  background-color: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.accordion-card:hover {
  border-color: var(--color-border-hover);
  box-shadow: var(--shadow-md);
}

.accordion-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background-color: #FFFFFF;
  text-align: left;
  gap: 16px;
  border-bottom: 1px solid transparent;
  transition: background-color var(--transition-fast);
}

.accordion-header:hover {
  background-color: #FAFAFA;
}

.accordion-card.is-open .accordion-header {
  border-bottom-color: var(--color-border);
  background-color: #FCFDFD;
}

.accordion-title-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.accordion-icon {
  font-size: 22px;
  line-height: 1;
}

.accordion-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-text-main);
}

.accordion-badge {
  font-size: 12px;
  font-weight: 600;
  padding: 2px 9px;
  border-radius: var(--radius-full);
  background-color: var(--color-bg-surface-alt);
  color: var(--color-text-muted);
}

.accordion-chevron {
  color: var(--color-text-muted);
  transition: transform var(--transition-normal);
  flex-shrink: 0;
}

.accordion-card.is-open .accordion-chevron {
  transform: rotate(180deg);
}

/* Accordion Content & Tables */
.accordion-content {
  display: none;
  background-color: #FFFFFF;
}

.accordion-card.is-open .accordion-content {
  display: block;
}

.price-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.price-table th {
  background-color: var(--color-bg-surface-alt);
  color: var(--color-text-muted);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 10px 20px;
  border-bottom: 1px solid var(--color-border);
}

.price-table td {
  padding: 14px 20px;
  border-bottom: 1px solid var(--color-border);
  font-size: 14.5px;
  vertical-align: middle;
}

.price-table tr:last-child td {
  border-bottom: none;
}

.price-table tbody tr {
  transition: background-color var(--transition-fast);
}

.price-table tbody tr:hover {
  background-color: #F8FAFC;
}

.item-name-cell {
  font-weight: 600;
  color: var(--color-text-main);
  padding: 10px 16px;
}

.produce-item-flex {
  display: flex;
  align-items: center;
  gap: 12px;
}

.produce-img-wrap {
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: #F1F5F9;
  border: 1px solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 4px;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.price-table tr:hover .produce-img-wrap {
  transform: scale(1.08);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

.produce-thumbnail {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.produce-name-details {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.produce-title-row {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.produce-name-en {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--color-text-main);
  line-height: 1.3;
}

.produce-name-ta {
  font-size: 0.82rem;
  font-weight: 600;
  color: #15803D; /* Fresh herbal green for Tamil */
  line-height: 1.3;
  letter-spacing: 0.01em;
}

.card-fruit-theme .produce-name-ta {
  color: #EA580C; /* Citrus warm orange for fruit Tamil names */
}

.produce-meta-mobile {
  display: none; /* Shown on mobile */
  align-items: center;
  gap: 6px;
  margin-top: 3px;
  flex-wrap: wrap;
}

.unit-tag-mobile {
  display: inline-block;
  padding: 1px 7px;
  border-radius: 4px;
  background-color: #F1F5F9;
