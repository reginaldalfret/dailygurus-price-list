# ==============================================================================
# DailyGurus Price List - Environment Variables Example
# ==============================================================================

# Supabase Public API (Accessible by browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret (Server-side ONLY - Never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication Secret (For JWT session signing)
ADMIN_JWT_SECRET=your-random-secure-jwt-secret-key-32-chars-min

# Site URL
NEXT_PUBLIC_SITE_URL=https://pricelist.reginaldalfret.tech
