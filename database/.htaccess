# Deny direct browser access to SQLite database files & directory
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<FilesMatch "\.(sqlite|sqlite3|db|sql|log)$">
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
